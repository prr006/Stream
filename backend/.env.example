# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must EXACTLY match an "Authorized redirect URI" on the OAuth client.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- storage / cache -------------------------------------------------------

# Where probes, plans and the range cache live (defaults to ./cache).
#CACHE_DIR=/home/user/.mystream/cache

# RangeCache (docs/ARCHITECTURE.md §11): chunked LRU cache of Drive bytes
# behind /stream. 0 = DISABLED → exact POC passthrough behavior (each
# request goes to Drive). On the GPU PC the arch recommends 200 GB so a
# full season is fetched from Drive at most once.
#RANGE_CACHE_MAX_BYTES=0
# Recommended (arch §11): 214748364800  (200 GB)
#RANGE_CACHE_MAX_BYTES=214748364800
# Defaults to $CACHE_DIR/range.
#RANGE_CACHE_DIR=/home/user/.mystream/cache/range

# Plan cache TTL is 24 h (plancache.PLAN_TTL_S); no env override.

# --- media engine ----------------------------------------------------------

# P1 toggle (docs/ARCHITECTURE.md §6): when "1", the remux / audio-transcode
# / transcode rungs are marked implemented (the DASH segment origin serves
# them). Until the P1 origin is deployed, keep "0" — plans for those rungs
# are still emitted (with stable /dash/…/manifest.mpd URLs) but honestly
# flagged implemented=false.
DASH_ORIGIN_ENABLED=0

# --- misc ------------------------------------------------------------------

# Override the Drive API base (tests point this at a local fake Drive).
#DRIVE_API_BASE=https://www.googleapis.com/drive/v3

# Where the OAuth token is stored after first login (defaults to ./token.json).
#TOKEN_FILE=/home/user/.mystream/token.json

# Subtitle extraction timeout in seconds.
#EXTRACT_TIMEOUT_S=1800
